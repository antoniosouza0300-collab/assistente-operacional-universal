# ==========================================
# Configurações Gerais do Sistema
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Assistente Operacional Universal"

# ==========================================
# Modelos Locais e Servidores de Inferência
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3

VLLM_BASE_URL=http://localhost:8000/v1
VLLM_DEFAULT_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# ==========================================
# Chaves de API para Provedores em Nuvem
# ==========================================
# OpenAI (utilizado por LangGraph, CrewAI, DSPy, LlamaIndex, etc.)
OPENAI_API_KEY=sua_chave_openai_aqui

# Anthropic (Claude)
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Hugging Face (Transformers e Hub)
HUGGINGFACE_HUB_TOKEN=seu_token_huggingface_aqui

# ==========================================
# Banco de Dados e Armazenamento (Opcional)
# ==========================================
# DATABASE_URL=sqlite:///./assistente.db
# VECTOR_DB_PATH=./data/vector_store
